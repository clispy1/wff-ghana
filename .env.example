# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# Project URL + anon key: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Service role key: same page, "service_role" secret.
# SERVER ONLY. Bypasses RLS. Never prefix this with NEXT_PUBLIC_ and
# never commit the real value.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------
# Paystack
# ---------------------------------------------------------------
# Dashboard -> Settings -> API Keys & Webhooks.
# Use the sk_test_/pk_test_ pair until you go live.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxx"

# Register this URL as your webhook in the Paystack dashboard:
#   https://your-domain.com/api/paystack/webhook
# Paystack signs webhooks with PAYSTACK_SECRET_KEY, so there is no
# separate webhook secret to configure.

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
# Absolute base URL, used to build Paystack callback links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Athlete registration fee, in GHS.
NEXT_PUBLIC_REGISTRATION_FEE="500"

# Flat merchandise shipping fee, in GHS. Read by both the checkout
# summary and the server that prices the order — keep it one variable so
# they can never disagree.
NEXT_PUBLIC_SHOP_SHIPPING_FEE="30"

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
